# Backend ayarları. Kopyalayıp adını ".env" yapın. .env GitHub'a GÖNDERİLMEZ.
DATABASE_URL=postgresql://fitapp:fitapp@localhost:5432/fitapp
REDIS_URL=redis://localhost:6379
JWT_SECRET=buraya-uzun-rastgele-bir-deger

# E-posta: "console" = e-posta gönderilmez, doğrulama kodu sunucu kaydına yazılır (sadece test).
# Gerçek e-posta servisi seçilince burası değişir.
EMAIL_MODE=console

# Başvuru belgeleri bu klasörde (gizli) saklanır
STORAGE_DIR=./storage
