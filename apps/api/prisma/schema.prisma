// Veritabanı şeması — tüm tablolar burada.
// Her bölüm docs/features/ altındaki bir özellik dokümanına karşılık gelir.
// Birimler metriktir: kg, cm, ml, gram, kcal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// HESAP — docs/features/accounts-and-profiles.md
// ═══════════════════════════════════════════════════════════════

enum RoleType {
  USER
  DIETITIAN
  TRAINER
  GYM_MANAGER
  GYM_STAFF
  MODERATOR
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  username            String    @unique // @kullaniciadi
  firstName           String?
  lastName            String?
  birthDate           DateTime  @db.Date // Yaş kuralları (genç modu) buradan hesaplanır
  gender              Gender    @default(UNSPECIFIED)
  heightCm            Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Hesap silme: talep tarihi. 30 gün sonra kalıcı silinir; bu sürede giriş yaparsa iptal olur.
  deletionRequestedAt DateTime?

  roles            UserRole[]
  consents         Consent[]
  parentalConsents ParentalConsent[]
  sessions         Session[]
  profile          Profile?

  following   Follow[] @relation("follower")
  followers   Follow[] @relation("followed")
  blocking    Block[]  @relation("blocker")
  blockedBy   Block[]  @relation("blocked")
  reportsMade Report[] @relation("reporter")

  onboardingAnswers OnboardingAnswer[]
  goals             UserGoal[]

  mealLogs         MealLog[]
  nutritionTargets NutritionTarget[]
  waterLogs        WaterLog[]
  weightLogs       WeightLog[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]

  programsAuthored Program[]
  enrollments      ProgramEnrollment[]

  professionalProfile      ProfessionalProfile?
  professionalApplications ProfessionalApplication[]
  clientOf                 ClientRelationship[]      @relation("client")
  reviewsWritten           Review[]

  conversations ConversationParticipant[]
  messagesSent  Message[]
  notifications Notification[]
  files         File[]

  auditActed    AuditLog[] @relation("auditActor")
  auditTargeted AuditLog[] @relation("auditTarget")

  measurements       Measurement[]      @relation("measured")
  measurementsMade   Measurement[]      @relation("measurementEnteredBy")
  intakeQuestions    IntakeQuestion[]
  intakeAnswers      IntakeAnswer[]     @relation("answerSubject")
  intakeAnswersGiven IntakeAnswer[]     @relation("answerGivenBy")
  notesWritten       ProfessionalNote[] @relation("noteAuthor")
  notesAbout         ProfessionalNote[] @relation("noteSubject")

  findingsOwned ReviewFinding[] @relation("findingOwner")
  findingsAbout ReviewFinding[] @relation("findingSubject")
  tasksOwned    FollowUpTask[]  @relation("taskOwner")
  tasksAbout    FollowUpTask[]  @relation("taskSubject")

  plansOwned  NutritionPlan[] @relation("planOwner")
  plansAbout  NutritionPlan[] @relation("planSubject")
  planChoices PlanChoice[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// KVKK rızaları: kim, neye, hangi metin sürümüyle, ne zaman izin verdi / geri çekti
model Consent {
  id          String    @id @default(uuid())
  userId      String
  type        String // ör. "health_data", "marketing", "terms"
  textVersion String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Genç modu: 13–17 yaş kullanıcılar için veli onayı
model ParentalConsent {
  id          String    @id @default(uuid())
  userId      String
  parentEmail String
  scope       String // ör. "health_data", "contact_professionals"
  token       String    @unique // Veliye giden onay bağlantısındaki kod
  approvedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Giriş oturumları (her cihaz ayrı oturum, tek tek kapatılabilir)
model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// PROFİL VE SOSYAL — docs/features/accounts-and-profiles.md
// ═══════════════════════════════════════════════════════════════

model Profile {
  userId    String  @id
  bio       String?
  avatarId  String? // File.id
  isPrivate Boolean @default(true) // Normal kullanıcılar varsayılan gizli hesap

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FollowStatus {
  PENDING // Gizli hesaba gönderilmiş, onay bekliyor
  ACCEPTED
}

model Follow {
  followerId String
  followedId String
  status     FollowStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, status])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

enum ReportTargetType {
  USER
  MESSAGE
  REVIEW
  PROGRAM
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

// Şikayetler admin panelinde incelenir
model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  reviewedBy String? // Admin User.id
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// KAYIT ÖNCESİ SORULAR — docs/features/onboarding.md
// ═══════════════════════════════════════════════════════════════

enum GoalType {
  LOSE_WEIGHT
  GAIN_MUSCLE
  STAY_FIT
  IMPROVE_POSTURE
  EAT_HEALTHY
  FACE_CARE
}

model OnboardingAnswer {
  id          String   @id @default(uuid())
  userId      String
  questionKey String // ör. "workout_location", "level"
  answer      Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
}

model UserGoal {
  userId    String
  goal      GoalType
  isPrimary Boolean  @default(false) // Ana sayfa düzeni ana hedefe göre belirlenir
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, goal])
}

// ═══════════════════════════════════════════════════════════════
// BESLENME — docs/features/nutrition.md
// ═══════════════════════════════════════════════════════════════

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  RECIPE // Türk yemekleri: standart tariften hesaplanmış
  ADMIN
}

model Food {
  id         String     @id @default(uuid())
  name       String
  category   String?
  barcode    String?    @unique
  // 100 g başına değerler
  kcal       Float
  proteinG   Float
  carbsG     Float
  fatG       Float
  source     FoodSource
  isEstimate Boolean    @default(true) // Tüm değerler varsayılan tahmini
  verifiedBy String? // Düzelten diyetisyenin User.id'si
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  portions FoodPortion[]
  logItems MealLogItem[]

  @@index([name])
}

// Ev ölçüleri: "1 kepçe" = 250 g gibi
model FoodPortion {
  id     String @id @default(uuid())
  foodId String
  label  String // "1 kepçe", "1 dilim", "1 kase"
  grams  Float

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealLog {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  mealType MealType

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealLogItem[]

  @@unique([userId, date, mealType])
}

model MealLogItem {
  id        String  @id @default(uuid())
  mealLogId String
  foodId    String
  grams     Float
  portionId String? // Ev ölçüsüyle eklendiyse hangisi
  quantity  Float? // Kaç porsiyon

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    Food    @relation(fields: [foodId], references: [id])
}

// Günlük kalori/makro hedefi. Diyetisyen belirlediyse setById dolu olur.
model NutritionTarget {
  id        String   @id @default(uuid())
  userId    String
  kcal      Float
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  waterMl   Float?
  setById   String? // Diyetisyen User.id; boşsa sistem hesapladı
  validFrom DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom])
}

// ═══════════════════════════════════════════════════════════════
// İLERLEME — docs/features/progress-tracking.md
// ═══════════════════════════════════════════════════════════════

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  amountMl Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model WeightLog {
  id       String   @id @default(uuid())
  userId   String
  weightKg Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model BodyMeasurement {
  id       String   @id @default(uuid())
  userId   String
  part     String // "waist", "hip", "chest", "arm"...
  valueCm  Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, part, loggedAt])
}

model ProgressPhoto {
  id      String   @id @default(uuid())
  userId  String
  fileId  String
  takenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// EGZERSİZ — docs/features/exercises.md
// ═══════════════════════════════════════════════════════════════

enum ExerciseCategory {
  FITNESS
  HOME
  POSTURE
  FACE_MASSAGE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Exercise {
  id          String           @id @default(uuid())
  code        String           @unique // "squat" — video dosyası bu kodla eşleşir
  name        String
  category    ExerciseCategory
  difficulty  Difficulty
  equipment   String[]
  steps       String[] // Adım adım yapılış
  mistakes    String[] // Sık yapılan hatalar
  warnings    String[]
  videoFileId String? // Boşsa video alanı gizlenir
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  muscles     ExerciseMuscle[]
  programDays ProgramDayExercise[]
}

// Kas haritası için kaslar
model Muscle {
  id   String @id @default(uuid())
  code String @unique // "quadriceps", "trapezius"... çizimdeki bölgeyle eşleşir
  name String

  exercises ExerciseMuscle[]
}

enum MuscleRole {
  PRIMARY // Haritada koyu
  SECONDARY // Haritada açık
}

model ExerciseMuscle {
  exerciseId String
  muscleId   String
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle   Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleId])
}

// ═══════════════════════════════════════════════════════════════
// PROGRAMLAR — docs/features/programs.md
// ═══════════════════════════════════════════════════════════════

enum PublishStatus {
  DRAFT
  PENDING_REVIEW // Profesyonel yayınlamak istedi, admin onayı bekliyor
  PUBLISHED
  REJECTED
}

model Program {
  id            String        @id @default(uuid())
  authorId      String? // Boşsa platformun kendi programı
  title         String
  description   String?
  difficulty    Difficulty
  durationWeeks Int
  daysPerWeek   Int
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  days        ProgramDay[]
  enrollments ProgramEnrollment[]
}

model ProgramDay {
  id        String  @id @default(uuid())
  programId String
  dayNumber Int
  title     String?

  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramDayExercise[]

  @@unique([programId, dayNumber])
}

model ProgramDayExercise {
  id           String @id @default(uuid())
  programDayId String
  exerciseId   String
  order        Int
  sets         Int?
  reps         Int?
  durationSec  Int?
  restSec      Int?

  programDay ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
}

// Kullanıcı bir programa başladı (kendisi veya profesyoneli atadı)
model ProgramEnrollment {
  id            String    @id @default(uuid())
  userId        String
  programId     String
  assignedById  String? // Profesyonel atadıysa
  startedAt     DateTime  @default(now())
  completedDays Int[] // Tamamlanan gün numaraları
  finishedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model DietGuide {
  id        String        @id @default(uuid())
  slug      String        @unique // "akdeniz", "keto"
  title     String
  content   String // Markdown
  status    PublishStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PROFESYONELLER — docs/features/professionals.md
// ═══════════════════════════════════════════════════════════════

enum ProfessionalType {
  DIETITIAN
  TRAINER
  GYM
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceMode {
  ONLINE
  IN_PERSON
  BOTH
}

model ProfessionalProfile {
  userId          String             @id
  type            ProfessionalType
  title           String? // "Uzman Diyetisyen"
  specialties     String[]
  city            String?
  serviceMode     ServiceMode        @default(BOTH)
  priceMin        Int? // TL, profesyonelin kendi beyanı
  priceMax        Int?
  verification    VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ProfessionalDocument[]
  clients   ClientRelationship[]   @relation("professional")
  reviews   Review[]

  @@index([type, verification, city])
}

// Diploma / sertifika — admin inceler
model ProfessionalDocument {
  id             String   @id @default(uuid())
  professionalId String
  fileId         String
  kind           String // "diploma", "certificate"
  uploadedAt     DateTime @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  file         File                @relation(fields: [fileId], references: [id])
}

enum ClientStatus {
  OFFERED // Profesyonel teklif etti, kullanıcı henüz kabul etmedi
  ACTIVE
  ENDED
}

enum SharedDataType {
  MEALS
  WATER
  WEIGHT
  MEASUREMENTS
  PHOTOS
  ANAMNESIS // Sağlık öyküsü, alerji, hastalık, yaşam tarzı yanıtları
}

// Danışan bağlantısı. Hizmet almanın kanıtı budur (yorum yazma hakkı buna bağlı).
model ClientRelationship {
  id             String           @id @default(uuid())
  professionalId String
  clientId       String
  status         ClientStatus     @default(OFFERED)
  sharedData     SharedDataType[] // Kullanıcının paylaşmaya izin verdiği veriler
  sharedUntil    DateTime? // Boşsa danışanlık bitene kadar; dolunca profesyonel verilere erişimi kaybeder
  offeredAt      DateTime         @default(now())
  acceptedAt     DateTime? // Boş kalıp endedAt doluysa teklif reddedilmiş/geri çekilmiştir
  endedAt        DateTime? // Doldurulduğu an profesyonel verilere erişimi kaybeder
  endedById      String? // Danışanlığı kim sonlandırdı (danışan veya profesyonel)

  professional ProfessionalProfile @relation("professional", fields: [professionalId], references: [userId], onDelete: Cascade)
  client       User                @relation("client", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, status])
  @@index([clientId, status])
}

// ═══════════════════════════════════════════════════════════════
// DANIŞAN DOSYASI — ölçümler, anamnez (sağlık öyküsü), uzman notları
// Sağlık verisidir: profesyonel buna sadece AccessService üzerinden (danışanlık + paylaşım + rıza) erişir.
// ═══════════════════════════════════════════════════════════════

enum DataSource {
  SELF // Kişi kendisi girdi
  PROFESSIONAL // Danışanın uzmanı girdi
  DEVICE // Cihazdan geldi (ileride)
}

enum MeasurementKind {
  WEIGHT // kg
  HEIGHT // cm
  WAIST // cm
  HIP // cm
  CHEST // cm
  ARM // cm
  THIGH // cm
  BODY_FAT_PERCENT // %
  MUSCLE_MASS // kg
  BODY_WATER_PERCENT // %
}

// Ölçüm yöntemi: aynı değer farklı yöntemle ölçülünce farklı çıkabilir; karşılaştırırken gösterilir
enum MeasurementMethod {
  SCALE // Tartı
  TAPE // Mezura
  CALIPER // Kaliper (deri kıvrımı)
  BIA // Biyoelektrik empedans (vücut analiz tartısı/cihazı)
  DEXA
  SELF_REPORT // Kişi yöntemi belirtmeden bildirdi
  OTHER
}

// Ölçümler sadece eklenir; yanlış girişler silinmez, "geçersiz" işaretlenir (voidedAt).
model Measurement {
  id          String            @id @default(uuid())
  userId      String // Ölçülen kişi
  kind        MeasurementKind
  value       Float // Birim türden bellidir (kg, cm, %)
  method      MeasurementMethod
  deviceName  String?
  source      DataSource
  enteredById String?
  takenAt     DateTime
  note        String?
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime          @default(now())

  user      User  @relation("measured", fields: [userId], references: [id], onDelete: Cascade)
  enteredBy User? @relation("measurementEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([userId, kind, takenAt])
}

enum IntakeQuestionType {
  TEXT
  NUMBER
  SINGLE_CHOICE
  MULTI_CHOICE
}

// Uzmanın kendi eklediği anamnez soruları (standart sorular kodda tanımlıdır: modules/clients/intake-template.ts)
model IntakeQuestion {
  id        String             @id @default(uuid())
  ownerId   String // Soruyu ekleyen profesyonel
  section   String
  text      String
  type      IntakeQuestionType
  options   String[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
}

// Yanıtlar sadece eklenir; güncel yanıt, soru başına en yeni kayıttır. Eski yanıtlar geçmiş olarak kalır.
// questionKey: standart soru için "std.xxx", uzman sorusu için "custom.<IntakeQuestion.id>"
model IntakeAnswer {
  id           String     @id @default(uuid())
  userId       String // Yanıtın ait olduğu kişi (danışan)
  questionKey  String
  value        Json
  source       DataSource
  answeredById String?
  answeredAt   DateTime   @default(now())

  user       User  @relation("answerSubject", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User? @relation("answerGivenBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([userId, questionKey, answeredAt])
}

// Uzmanın görüşme notları: danışana gösterilmez, sadece yazan uzman okur.
model ProfessionalNote {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  text           String
  createdAt      DateTime @default(now())

  professional User @relation("noteAuthor", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User @relation("noteSubject", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, clientId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// UZMAN İNCELEME ÖZETİ — kırmızı/sarı/yeşil maddeler ve takip görevleri
// Maddeler otomatik TUTARLILIK kontrolleridir (eksik/eski bilgi, danışanın kendi beyanı); tanı ya da tedavi önerisi değildir.
// Karar her zaman uzmandadır: not ekler, gerekçeyle kapatır ya da takip görevine çevirir.
// ═══════════════════════════════════════════════════════════════

enum FindingLevel {
  RED // Uzman tarafından incelenmesi gereken olası risk
  YELLOW // Eksik, eski veya şüpheli bilgi; danışana sorulacak soru
  GREEN // Değerlendirilebilecek öneri / uygun seçenek
}

enum FindingStatus {
  OPEN
  FOLLOW_UP // Takip görevi açıldı, sonuç bekleniyor
  CLOSED // Uzman gerekçesiyle kapattı
  SUPERSEDED // Dayanak bilgi değişti, madde artık geçerli değil (otomatik)
}

// Bir madde, (uzman, danışan, parmak izi) başına bir kez oluşur. Parmak izi kural + dayanak değerlerinden türer:
// dayanak değişirse yeni madde açılır; kapatılmış bir madde aynı dayanakla yeniden açılmaz.
model ReviewFinding {
  id             String           @id @default(uuid())
  professionalId String
  clientId       String
  ruleCode       String
  fingerprint    String
  level          FindingLevel
  title          String
  detail         String
  basis          Json // Hangi bilgiye dayandığı: [{ type, label, display, at }]
  categories     SharedDataType[] // Bu maddeyi görmek için gereken paylaşım kategorileri
  status         FindingStatus    @default(OPEN)
  decision       String? // EVALUATED | NOT_APPLICABLE | CLIENT_INFORMED | OTHER
  closedReason   String?
  closedAt       DateTime?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())

  professional User                 @relation("findingOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User                 @relation("findingSubject", fields: [clientId], references: [id], onDelete: Cascade)
  events       ReviewFindingEvent[]
  tasks        FollowUpTask[]

  @@unique([professionalId, clientId, fingerprint])
  @@index([professionalId, clientId, status])
}

// Maddenin geçmişi: not, kapatma + gerekçe, yeniden açma, görev, otomatik geçersizleşme. Sadece eklenir.
model ReviewFindingEvent {
  id        String   @id @default(uuid())
  findingId String
  kind      String // NOTE | CLOSED | REOPENED | TASK_CREATED | TASK_DONE | SUPERSEDED
  text      String?
  byId      String?
  createdAt DateTime @default(now())

  finding ReviewFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

enum TaskStatus {
  OPEN
  DONE
}

// Uzmanın danışanla ilgili takip görevi (bir maddeden ya da kendiliğinden).
model FollowUpTask {
  id             String     @id @default(uuid())
  professionalId String
  clientId       String
  findingId      String?
  title          String
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  doneAt         DateTime?
  createdAt      DateTime   @default(now())

  professional User           @relation("taskOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User           @relation("taskSubject", fields: [clientId], references: [id], onDelete: Cascade)
  finding      ReviewFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([professionalId, status, dueAt])
  @@index([professionalId, clientId])
}

// ═══════════════════════════════════════════════════════════════
// BESLENME PLANI — uzman onaylı, sürümlü, alternatifli
// Plan, uzman onaylamadan danışana GİTMEZ. Onaylanmış sürümler değiştirilmez; düzenleme yeni taslakla yapılır.
// İçerikteki yiyecek, porsiyon ve alerjen bilgileri uzmanındır; sistem tıbbi doğruluk iddia etmez.
// ═══════════════════════════════════════════════════════════════

enum PlanVersionStatus {
  DRAFT // Uzmanın çalışma kopyası (danışan görmez)
  APPROVED // Uzman onayladı; danışana yayında olan sürüm
  SUPERSEDED // Daha yeni bir sürüm yayınlandı
}

// Bir uzman–danışan çifti için tek plan; sürümler geçmişi oluşturur.
model NutritionPlan {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  createdAt      DateTime @default(now())

  professional User          @relation("planOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User          @relation("planSubject", fields: [clientId], references: [id], onDelete: Cascade)
  versions     PlanVersion[]
  events       PlanEvent[]
  choices      PlanChoice[]

  @@unique([professionalId, clientId])
}

// `number` onaylanınca verilir (taslakta boş). `content`: öğünler, alternatifler, porsiyonlar, değiştirme kuralları (JSON).
model PlanVersion {
  id            String            @id @default(uuid())
  planId        String
  number        Int?
  status        PlanVersionStatus @default(DRAFT)
  content       Json
  changeNote    String?
  basedOnNumber Int? // Hangi sürümden türetildi
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  // Onay anında uzmanın bilerek geçtiği uyarılar (kayıt için)
  acknowledged  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, number])
  @@index([planId, status])
}

// Plan geçmişi: kim, ne zaman, ne yaptı. Sadece eklenir.
model PlanEvent {
  id        String   @id @default(uuid())
  planId    String
  versionId String?
  kind      String // DRAFT_CREATED | DRAFT_EDITED | DRAFT_DISCARDED | APPROVED | SUPERSEDED
  text      String?
  byId      String?
  createdAt DateTime @default(now())

  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

// Danışanın bir gün için bir öğünde seçtiği alternatif(ler). Sadece o sürümde izinli seçenekler seçilebilir.
model PlanChoice {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  versionId String
  date      String // YYYY-AA-GG
  mealId    String
  optionIds String[]
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, date, mealId])
  @@index([planId, date])
}

// Denetim kaydı: bir kişinin sağlık verisine kim, ne zaman, ne yaptı. Sadece eklenir; değiştirilmez.
// Kaydın konusu olan kullanıcı (targetUser) neyin kimle paylaşıldığını ve kimin baktığını buradan görür.
// targetUser silinince kayıtları da silinir; actor silinirse kayıt kalır, actorId boşalır.
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  targetUserId   String
  // OFFER_SENT, OFFER_ACCEPTED, OFFER_DECLINED, SHARING_CHANGED, RELATIONSHIP_ENDED, DATA_VIEWED, ACCESS_DENIED ...
  action         String
  category       String? // SharedDataType değeri
  relationshipId String?
  meta           Json?
  createdAt      DateTime @default(now())

  actor      User? @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User  @relation("auditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

// Sadece danışan bağlantısı kurulmuş (acceptedAt dolu) kullanıcılar yazabilir
model Review {
  id             String    @id @default(uuid())
  professionalId String
  authorId       String
  rating         Int // 1–5
  comment        String?
  reply          String? // Profesyonelin tek cevabı
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  author       User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([professionalId, authorId]) // Kişi başı bir yorum
}

// ═══════════════════════════════════════════════════════════════
// MESAJLAŞMA — docs/features/messaging.md
// ═══════════════════════════════════════════════════════════════

enum ConversationStatus {
  REQUESTED // Normal kullanıcıya giden ilk mesaj, kabul bekliyor
  OPEN
  DECLINED
}

model Conversation {
  id            String             @id @default(uuid())
  status        ConversationStatus @default(OPEN)
  initiatorId   String
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime? // Okundu bilgisi

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String?
  fileId         String? // Fotoğraf gönderildiyse
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // Silinen mesaj iz bırakır (şikayet incelemesi için)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// DİĞER
// ═══════════════════════════════════════════════════════════════

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // "new_message", "follow_request", "client_offer"...
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Yüklenen dosyalar (fotoğraf, belge, video). Dosyanın kendisi depolama servisinde durur.
model File {
  id         String   @id @default(uuid())
  ownerId    String?
  storageKey String   @unique // Depolama servisindeki yolu
  mimeType   String
  sizeBytes  Int
  isPrivate  Boolean  @default(true)
  createdAt  DateTime @default(now())

  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  progressPhotos        ProgressPhoto[]
  professionalDocuments ProfessionalDocument[]
}

// ═══════════════════════════════════════════════════════════════
// KAYIT VE PROFESYONEL BAŞVURU — docs/features/registration.md
// ═══════════════════════════════════════════════════════════════

enum AccountType {
  USER
  PROFESSIONAL
}

// Profesyonel olarak açılmak istenen alan (hesap açılırken seçilir)
enum ProfessionalField {
  DIETITIAN
  TRAINER
  GYM_OWNER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// E-posta doğrulama kodu girilene kadar hesap OLUŞMAZ; kayıt bilgileri burada geçici tutulur.
// Kullanıcı adı ve e-posta bu sürede (kısa süre) rezerve sayılır.
model PendingRegistration {
  id            String      @id @default(uuid())
  email         String
  username      String
  passwordHash  String
  accountType   AccountType
  // Ad, doğum tarihi, rızalar, profesyonel alan ve alana özel bilgiler
  payload       Json
  codeHash      String // Doğrulama kodunun özeti (kodun kendisi saklanmaz)
  codeExpiresAt DateTime
  attempts      Int         @default(0)
  sendCount     Int         @default(1)
  lastSentAt    DateTime    @default(now())
  expiresAt     DateTime
  ipAddress     String?
  createdAt     DateTime    @default(now())

  documents PendingDocument[]

  @@index([email])
  @@index([username])
  @@index([expiresAt])
}

model PendingDocument {
  id             String   @id @default(uuid())
  registrationId String
  kind           String // "diploma", "certificate", "business_license"...
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String   @unique
  // Otomatik işaretler: DUPLICATE_DOCUMENT, EDITING_SOFTWARE_TRACE...
  flags          String[]
  createdAt      DateTime @default(now())

  registration PendingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// Profesyonel hesap başvurusu. Onaylanana kadar kişi sadece standart kullanıcıdır.
model ProfessionalApplication {
  id              String            @id @default(uuid())
  userId          String
  field           ProfessionalField
  status          ApplicationStatus @default(PENDING)
  // Şehir, uzmanlık alanları, salon adı/adresi gibi alana özel bilgiler
  details         Json
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  attemptNumber   Int               @default(1)
  submittedAt     DateTime          @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ApplicationDocument[]

  @@index([status, submittedAt])
  @@index([userId])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  kind          String
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String
  storageKey    String   @unique
  flags         String[]
  createdAt     DateTime @default(now())

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  accessLogs  DocumentAccessLog[]

  @@index([sha256])
}

// Belgeleri kim, ne zaman açtı (kişisel veri olduğu için kayıt altındadır)
model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String
  adminId    String
  at         DateTime @default(now())

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
