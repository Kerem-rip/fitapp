// Veritabanı şeması — tüm tablolar burada.
// Her bölüm docs/features/ altındaki bir özellik dokümanına karşılık gelir.
// Birimler metriktir: kg, cm, ml, gram, kcal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// HESAP — docs/features/accounts-and-profiles.md
// ═══════════════════════════════════════════════════════════════

enum RoleType {
  USER
  DIETITIAN
  TRAINER
  GYM_MANAGER
  GYM_STAFF
  MODERATOR
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  username            String    @unique // @kullaniciadi
  firstName           String?
  lastName            String?
  birthDate           DateTime  @db.Date // Yaş kuralları (genç modu) buradan hesaplanır
  gender              Gender    @default(UNSPECIFIED)
  heightCm            Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Hesap silme: talep tarihi. 30 gün sonra kalıcı silinir; bu sürede giriş yaparsa iptal olur.
  deletionRequestedAt DateTime?

  roles              UserRole[]
  consents           Consent[]
  parentalConsents   ParentalConsent[]
  sessions           Session[]
  passwordReset      PasswordReset?
  libraryEnrollments LibraryEnrollment[]
  libraryTasks       LibraryTask[]
  profile            Profile?

  following     Follow[]        @relation("follower")
  followers     Follow[]        @relation("followed")
  blocking      Block[]         @relation("blocker")
  blockedBy     Block[]         @relation("blocked")
  muting        Mute[]          @relation("muter")
  mutedBy       Mute[]          @relation("muted")
  posts         Post[]
  postLikes     PostLike[]
  postSaves     PostSave[]
  postComments  PostComment[]
  postMentions  PostMention[]
  stories       Story[]
  storyViews    StoryView[]
  storyVotes    StoryPollVote[]
  storyAnswers  StoryAnswer[]
  closeFriends  CloseFriend[]   @relation("closeOwner")
  closeFriendOf CloseFriend[]   @relation("closeFriend")
  reportsMade   Report[]        @relation("reporter")

  onboardingAnswers OnboardingAnswer[]
  goals             UserGoal[]

  mealEntries      MealEntry[]
  nutritionTargets NutritionTarget[]
  waterLogs        WaterLog[]
  weightLogs       WeightLog[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]

  programsAuthored Program[]
  enrollments      ProgramEnrollment[]

  professionalProfile      ProfessionalProfile?
  professionalApplications ProfessionalApplication[]
  clientOf                 ClientRelationship[]      @relation("client")
  reviewsWritten           Review[]

  conversations ConversationParticipant[]
  messagesSent  Message[]
  notifications Notification[]
  files         File[]

  auditActed    AuditLog[] @relation("auditActor")
  auditTargeted AuditLog[] @relation("auditTarget")

  measurements       Measurement[]      @relation("measured")
  measurementsMade   Measurement[]      @relation("measurementEnteredBy")
  intakeQuestions    IntakeQuestion[]
  intakeAnswers      IntakeAnswer[]     @relation("answerSubject")
  intakeAnswersGiven IntakeAnswer[]     @relation("answerGivenBy")
  notesWritten       ProfessionalNote[] @relation("noteAuthor")
  notesAbout         ProfessionalNote[] @relation("noteSubject")

  findingsOwned ReviewFinding[] @relation("findingOwner")
  findingsAbout ReviewFinding[] @relation("findingSubject")
  tasksOwned    FollowUpTask[]  @relation("taskOwner")
  tasksAbout    FollowUpTask[]  @relation("taskSubject")

  plansOwned  NutritionPlan[] @relation("planOwner")
  plansAbout  NutritionPlan[] @relation("planSubject")
  planChoices PlanChoice[]

  gymOwned          Gym?
  gymStaffRoles     GymStaffMember[] @relation("gymStaffUser")
  appointmentsOwned Appointment[]    @relation("appointmentOwner")
  appointmentsAbout Appointment[]    @relation("appointmentSubject")
  goalsOwned        ClientGoal[]     @relation("goalOwner")
  goalsAbout        ClientGoal[]     @relation("goalSubject")
  remindersOwned    ClientReminder[] @relation("reminderOwner")
  remindersAbout    ClientReminder[] @relation("reminderSubject")

  programsOwned           TrainingProgram[]        @relation("programOwner")
  programsAbout           TrainingProgram[]        @relation("programSubject")
  workoutLogs             WorkoutLog[]             @relation("workoutSubject")
  dmMembers               DmMember[]
  dmMessages              DmMessage[]
  dmHiddens               DmHidden[]
  moderatorBranches       ModeratorBranch[]
  moderationAppeals       ModerationAppeal[]
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  planIntakes             PlanIntake[]
  planPurchases           PlanPurchase[]
  planInstances           PlanInstance[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// KVKK rızaları: kim, neye, hangi metin sürümüyle, ne zaman izin verdi / geri çekti
model Consent {
  id          String    @id @default(uuid())
  userId      String
  type        String // ör. "health_data", "marketing", "terms"
  textVersion String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Genç modu: 13–17 yaş kullanıcılar için veli onayı
model ParentalConsent {
  id          String    @id @default(uuid())
  userId      String
  parentEmail String
  scope       String // ör. "health_data", "contact_professionals"
  token       String    @unique // Veliye giden onay bağlantısındaki kod
  approvedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Giriş oturumları (her cihaz ayrı oturum, tek tek kapatılabilir)
model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Şifre sıfırlama: e-postaya 6 haneli kod gider. Kodun kendisi saklanmaz (anahtarlı özet).
// Kişi başı tek etkin kayıt; deneme ve gönderim sayısı sınırlıdır. Şifre değişince tüm oturumlar kapanır.
model PasswordReset {
  id            String   @id @default(uuid())
  userId        String   @unique
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0)
  sendCount     Int      @default(1)
  lastSentAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// PROFİL VE SOSYAL — docs/features/accounts-and-profiles.md
// ═══════════════════════════════════════════════════════════════

model Profile {
  userId       String    @id
  bio          String?
  avatarId     String? // File.id (herkese açık görsel)
  isPrivate    Boolean   @default(true) // Normal kullanıcılar varsayılan gizli hesap; doğrulanmış profesyoneller her zaman açık
  // Sosyal profil
  displayName  String? // Görünen ad; boşsa ad soyad kullanılır
  city         String?
  goals        String? // Spor hedefleri (serbest metin)
  links        Json? // [{ label, url }] en fazla 3
  sports       String[]  @default([]) // SportBranch.id listesi (spor ilgi alanları)
  // Mesaj gizliliği: EVERYONE → herkes yazabilir (takip etmediğin kişiler istek kutusuna düşer); FOLLOWING → sadece takip ettiklerin
  dmPolicy     DmPolicy  @default(EVERYONE)
  // Çevrimiçi / son görülme bilgisini paylaş (kapalıysa başkalarınınkini de görmez)
  showActivity Boolean   @default(true)
  lastSeenAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Spor branşları (ilgi alanı, keşfet filtresi). Uygulamanın sabit listesidir; geçişle eklenir.
model SportBranch {
  id        String @id // "fitness", "kosu"...
  name      String
  sortOrder Int    @default(0)
}

enum FollowStatus {
  PENDING // Gizli hesaba gönderilmiş, onay bekliyor
  ACCEPTED
}

model Follow {
  followerId String
  followedId String
  status     FollowStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, status])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

// Sessize alma: takip sürer ama kişinin paylaşımları akışta ve hikâyelerde görünmez. Karşı taraf bilmez.
model Mute {
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
}

enum ReportTargetType {
  USER
  MESSAGE
  REVIEW
  PROGRAM
  POST
  COMMENT
  STORY
  DM_MESSAGE
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

// Şikayetler admin panelinde incelenir
model Report {
  id             String           @id @default(uuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  reviewedBy     String? // Admin User.id
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  // Şikâyet edilen içeriğin sahibi ve onun spor branşları (branş moderatörleri sadece kendi branşlarını görür)
  targetUserId   String?
  branches       String[]         @default([])
  resolutionNote String?

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Moderatörün sorumlu olduğu spor branşları (kayıt yoksa genel moderatördür: tüm şikâyetleri görür)
model ModeratorBranch {
  userId  String
  sportId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
}

// Moderasyon kayıt defteri: kim, neyi, neden kaldırdı / geri getirdi / inceledi. Silinmez.
model ModerationAction {
  id           String   @id @default(uuid())
  moderatorId  String
  // VIEW_REPORTED_MESSAGE, REMOVE, RESTORE, DISMISS, APPEAL_ACCEPTED, APPEAL_REJECTED
  action       String
  targetType   String
  targetId     String
  targetUserId String?
  reportId     String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([moderatorId, createdAt])
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

// İtiraz: içeriği kaldırılan kişi bir kez itiraz edebilir; kabul edilirse içerik geri gelir
model ModerationAppeal {
  id         String       @id @default(uuid())
  userId     String
  targetType String
  targetId   String
  text       String
  status     AppealStatus @default(OPEN)
  reviewedBy String?
  reviewedAt DateTime?
  note       String?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId])
  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// KAYIT ÖNCESİ SORULAR — docs/features/onboarding.md
// ═══════════════════════════════════════════════════════════════

enum GoalType {
  LOSE_WEIGHT
  GAIN_MUSCLE
  STAY_FIT
  IMPROVE_POSTURE
  EAT_HEALTHY
  FACE_CARE
}

model OnboardingAnswer {
  id          String   @id @default(uuid())
  userId      String
  questionKey String // ör. "workout_location", "level"
  answer      Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
}

model UserGoal {
  userId    String
  goal      GoalType
  isPrimary Boolean  @default(false) // Ana sayfa düzeni ana hedefe göre belirlenir
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, goal])
}

// ═══════════════════════════════════════════════════════════════
// BESLENME — docs/features/nutrition.md
// ═══════════════════════════════════════════════════════════════

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  RECIPE // Türk yemekleri: standart tariften hesaplanmış
  ADMIN
}

model Food {
  id         String     @id @default(uuid())
  name       String
  category   String?
  barcode    String?    @unique
  // 100 g başına değerler
  kcal       Float
  proteinG   Float
  carbsG     Float
  fatG       Float
  source     FoodSource
  isEstimate Boolean    @default(true) // Tüm değerler varsayılan tahmini
  verifiedBy String? // Düzelten diyetisyenin User.id'si
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  portions FoodPortion[]

  @@index([name])
}

// Ev ölçüleri: "1 kepçe" = 250 g gibi
model FoodPortion {
  id     String @id @default(uuid())
  foodId String
  label  String // "1 kepçe", "1 dilim", "1 kase"
  grams  Float

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// Öğün kaydı: danışanın kendi günlüğü. Yemeğin adı, porsiyonu ve tahmini değerleri kayıt anındaki haliyle kopyalanır
// (yemek listesi sonradan değişse de geçmiş kayıt değişmez). Değerler TAHMİNİDİR. Gün Türkiye saatine göredir.
model MealEntry {
  id        String   @id @default(uuid())
  userId    String
  date      String // "YYYY-AA-GG"
  mealType  MealType
  foodKey   String? // Uygulamanın yemek listesindeki kimlik (varsa)
  name      String
  portion   String // "1 porsiyon", "1 kase"...
  servings  Float
  // Toplam (porsiyon sayısıyla çarpılmış) tahmini değerler
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// Günlük kalori/makro hedefi. Diyetisyen belirlediyse setById dolu olur.
model NutritionTarget {
  id        String   @id @default(uuid())
  userId    String
  kcal      Float
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  waterMl   Float?
  setById   String? // Diyetisyen User.id; boşsa sistem hesapladı
  validFrom DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom])
}

// ═══════════════════════════════════════════════════════════════
// İLERLEME — docs/features/progress-tracking.md
// ═══════════════════════════════════════════════════════════════

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  amountMl Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model WeightLog {
  id       String   @id @default(uuid())
  userId   String
  weightKg Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model BodyMeasurement {
  id       String   @id @default(uuid())
  userId   String
  part     String // "waist", "hip", "chest", "arm"...
  valueCm  Float
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, part, loggedAt])
}

model ProgressPhoto {
  id      String   @id @default(uuid())
  userId  String
  fileId  String
  takenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// EGZERSİZ — docs/features/exercises.md
// ═══════════════════════════════════════════════════════════════

enum ExerciseCategory {
  FITNESS
  HOME
  POSTURE
  FACE_MASSAGE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Exercise {
  id          String           @id @default(uuid())
  code        String           @unique // "squat" — video dosyası bu kodla eşleşir
  name        String
  category    ExerciseCategory
  difficulty  Difficulty
  equipment   String[]
  steps       String[] // Adım adım yapılış
  mistakes    String[] // Sık yapılan hatalar
  warnings    String[]
  videoFileId String? // Boşsa video alanı gizlenir
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  muscles     ExerciseMuscle[]
  programDays ProgramDayExercise[]
}

// Kas haritası için kaslar
model Muscle {
  id   String @id @default(uuid())
  code String @unique // "quadriceps", "trapezius"... çizimdeki bölgeyle eşleşir
  name String

  exercises ExerciseMuscle[]
}

enum MuscleRole {
  PRIMARY // Haritada koyu
  SECONDARY // Haritada açık
}

model ExerciseMuscle {
  exerciseId String
  muscleId   String
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle   Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleId])
}

// ═══════════════════════════════════════════════════════════════
// PROGRAMLAR — docs/features/programs.md
// ═══════════════════════════════════════════════════════════════

enum PublishStatus {
  DRAFT
  PENDING_REVIEW // Profesyonel yayınlamak istedi, admin onayı bekliyor
  PUBLISHED
  REJECTED
}

model Program {
  id            String        @id @default(uuid())
  authorId      String? // Boşsa platformun kendi programı
  title         String
  description   String?
  difficulty    Difficulty
  durationWeeks Int
  daysPerWeek   Int
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  days        ProgramDay[]
  enrollments ProgramEnrollment[]
}

model ProgramDay {
  id        String  @id @default(uuid())
  programId String
  dayNumber Int
  title     String?

  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramDayExercise[]

  @@unique([programId, dayNumber])
}

model ProgramDayExercise {
  id           String @id @default(uuid())
  programDayId String
  exerciseId   String
  order        Int
  sets         Int?
  reps         Int?
  durationSec  Int?
  restSec      Int?

  programDay ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
}

// Kullanıcı bir programa başladı (kendisi veya profesyoneli atadı)
model ProgramEnrollment {
  id            String    @id @default(uuid())
  userId        String
  programId     String
  assignedById  String? // Profesyonel atadıysa
  startedAt     DateTime  @default(now())
  completedDays Int[] // Tamamlanan gün numaraları
  finishedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model DietGuide {
  id        String        @id @default(uuid())
  slug      String        @unique // "akdeniz", "keto"
  title     String
  content   String // Markdown
  status    PublishStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PROFESYONELLER — docs/features/professionals.md
// ═══════════════════════════════════════════════════════════════

enum ProfessionalType {
  DIETITIAN
  TRAINER
  GYM
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceMode {
  ONLINE
  IN_PERSON
  BOTH
}

model ProfessionalProfile {
  userId          String             @id
  type            ProfessionalType
  title           String? // "Uzman Diyetisyen"
  specialties     String[]
  city            String?
  serviceMode     ServiceMode        @default(BOTH)
  priceMin        Int? // TL, profesyonelin kendi beyanı
  priceMax        Int?
  verification    VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ProfessionalDocument[]
  clients   ClientRelationship[]   @relation("professional")
  reviews   Review[]

  @@index([type, verification, city])
}

// Diploma / sertifika — admin inceler
model ProfessionalDocument {
  id             String   @id @default(uuid())
  professionalId String
  fileId         String
  kind           String // "diploma", "certificate"
  uploadedAt     DateTime @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  file         File                @relation(fields: [fileId], references: [id])
}

enum ClientStatus {
  OFFERED // Profesyonel teklif etti, kullanıcı henüz kabul etmedi
  ACTIVE
  ENDED
}

enum SharedDataType {
  MEALS
  WATER
  WEIGHT
  MEASUREMENTS
  PHOTOS
  ANAMNESIS // Sağlık öyküsü, alerji, hastalık, yaşam tarzı yanıtları
  WORKOUTS // Antrenman kayıtları (setler, efor, ağrı bildirimi)
}

// Danışan bağlantısı. Hizmet almanın kanıtı budur (yorum yazma hakkı buna bağlı).
model ClientRelationship {
  id             String           @id @default(uuid())
  professionalId String
  clientId       String
  status         ClientStatus     @default(OFFERED)
  sharedData     SharedDataType[] // Kullanıcının paylaşmaya izin verdiği veriler
  sharedUntil    DateTime? // Boşsa danışanlık bitene kadar; dolunca profesyonel verilere erişimi kaybeder
  offeredAt      DateTime         @default(now())
  acceptedAt     DateTime? // Boş kalıp endedAt doluysa teklif reddedilmiş/geri çekilmiştir
  endedAt        DateTime? // Doldurulduğu an profesyonel verilere erişimi kaybeder
  endedById      String? // Danışanlığı kim sonlandırdı (danışan veya profesyonel)

  professional ProfessionalProfile @relation("professional", fields: [professionalId], references: [userId], onDelete: Cascade)
  client       User                @relation("client", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, status])
  @@index([clientId, status])
}

// ═══════════════════════════════════════════════════════════════
// DANIŞAN DOSYASI — ölçümler, anamnez (sağlık öyküsü), uzman notları
// Sağlık verisidir: profesyonel buna sadece AccessService üzerinden (danışanlık + paylaşım + rıza) erişir.
// ═══════════════════════════════════════════════════════════════

enum DataSource {
  SELF // Kişi kendisi girdi
  PROFESSIONAL // Danışanın uzmanı girdi
  DEVICE // Cihazdan geldi (ileride)
}

enum MeasurementKind {
  WEIGHT // kg
  HEIGHT // cm
  WAIST // cm
  HIP // cm
  CHEST // cm
  ARM // cm
  THIGH // cm
  BODY_FAT_PERCENT // %
  MUSCLE_MASS // kg
  BODY_WATER_PERCENT // %
}

// Ölçüm yöntemi: aynı değer farklı yöntemle ölçülünce farklı çıkabilir; karşılaştırırken gösterilir
enum MeasurementMethod {
  SCALE // Tartı
  TAPE // Mezura
  CALIPER // Kaliper (deri kıvrımı)
  BIA // Biyoelektrik empedans (vücut analiz tartısı/cihazı)
  DEXA
  SELF_REPORT // Kişi yöntemi belirtmeden bildirdi
  OTHER
}

// Ölçümler sadece eklenir; yanlış girişler silinmez, "geçersiz" işaretlenir (voidedAt).
model Measurement {
  id          String            @id @default(uuid())
  userId      String // Ölçülen kişi
  kind        MeasurementKind
  value       Float // Birim türden bellidir (kg, cm, %)
  method      MeasurementMethod
  deviceName  String?
  source      DataSource
  enteredById String?
  takenAt     DateTime
  note        String?
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime          @default(now())

  user      User  @relation("measured", fields: [userId], references: [id], onDelete: Cascade)
  enteredBy User? @relation("measurementEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([userId, kind, takenAt])
}

enum IntakeQuestionType {
  TEXT
  NUMBER
  SINGLE_CHOICE
  MULTI_CHOICE
}

// Uzmanın kendi eklediği anamnez soruları (standart sorular kodda tanımlıdır: modules/clients/intake-template.ts)
model IntakeQuestion {
  id        String             @id @default(uuid())
  ownerId   String // Soruyu ekleyen profesyonel
  section   String
  text      String
  type      IntakeQuestionType
  options   String[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
}

// Yanıtlar sadece eklenir; güncel yanıt, soru başına en yeni kayıttır. Eski yanıtlar geçmiş olarak kalır.
// questionKey: standart soru için "std.xxx", uzman sorusu için "custom.<IntakeQuestion.id>"
model IntakeAnswer {
  id           String     @id @default(uuid())
  userId       String // Yanıtın ait olduğu kişi (danışan)
  questionKey  String
  value        Json
  source       DataSource
  answeredById String?
  answeredAt   DateTime   @default(now())

  user       User  @relation("answerSubject", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User? @relation("answerGivenBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([userId, questionKey, answeredAt])
}

// Uzmanın görüşme notları: danışana gösterilmez, sadece yazan uzman okur.
model ProfessionalNote {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  text           String
  createdAt      DateTime @default(now())

  professional User @relation("noteAuthor", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User @relation("noteSubject", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, clientId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// UZMAN İNCELEME ÖZETİ — kırmızı/sarı/yeşil maddeler ve takip görevleri
// Maddeler otomatik TUTARLILIK kontrolleridir (eksik/eski bilgi, danışanın kendi beyanı); tanı ya da tedavi önerisi değildir.
// Karar her zaman uzmandadır: not ekler, gerekçeyle kapatır ya da takip görevine çevirir.
// ═══════════════════════════════════════════════════════════════

enum FindingLevel {
  RED // Uzman tarafından incelenmesi gereken olası risk
  YELLOW // Eksik, eski veya şüpheli bilgi; danışana sorulacak soru
  GREEN // Değerlendirilebilecek öneri / uygun seçenek
}

enum FindingStatus {
  OPEN
  FOLLOW_UP // Takip görevi açıldı, sonuç bekleniyor
  CLOSED // Uzman gerekçesiyle kapattı
  SUPERSEDED // Dayanak bilgi değişti, madde artık geçerli değil (otomatik)
}

// Bir madde, (uzman, danışan, parmak izi) başına bir kez oluşur. Parmak izi kural + dayanak değerlerinden türer:
// dayanak değişirse yeni madde açılır; kapatılmış bir madde aynı dayanakla yeniden açılmaz.
model ReviewFinding {
  id             String           @id @default(uuid())
  professionalId String
  clientId       String
  ruleCode       String
  fingerprint    String
  level          FindingLevel
  title          String
  detail         String
  basis          Json // Hangi bilgiye dayandığı: [{ type, label, display, at }]
  categories     SharedDataType[] // Bu maddeyi görmek için gereken paylaşım kategorileri
  status         FindingStatus    @default(OPEN)
  decision       String? // EVALUATED | NOT_APPLICABLE | CLIENT_INFORMED | OTHER
  closedReason   String?
  closedAt       DateTime?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())

  professional User                 @relation("findingOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User                 @relation("findingSubject", fields: [clientId], references: [id], onDelete: Cascade)
  events       ReviewFindingEvent[]
  tasks        FollowUpTask[]

  @@unique([professionalId, clientId, fingerprint])
  @@index([professionalId, clientId, status])
}

// Maddenin geçmişi: not, kapatma + gerekçe, yeniden açma, görev, otomatik geçersizleşme. Sadece eklenir.
model ReviewFindingEvent {
  id        String   @id @default(uuid())
  findingId String
  kind      String // NOTE | CLOSED | REOPENED | TASK_CREATED | TASK_DONE | SUPERSEDED
  text      String?
  byId      String?
  createdAt DateTime @default(now())

  finding ReviewFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

enum TaskStatus {
  OPEN
  DONE
}

// Uzmanın danışanla ilgili takip görevi (bir maddeden ya da kendiliğinden).
model FollowUpTask {
  id             String     @id @default(uuid())
  professionalId String
  clientId       String
  findingId      String?
  title          String
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  doneAt         DateTime?
  createdAt      DateTime   @default(now())

  professional User           @relation("taskOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User           @relation("taskSubject", fields: [clientId], references: [id], onDelete: Cascade)
  finding      ReviewFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([professionalId, status, dueAt])
  @@index([professionalId, clientId])
}

// ═══════════════════════════════════════════════════════════════
// BESLENME PLANI — uzman onaylı, sürümlü, alternatifli
// Plan, uzman onaylamadan danışana GİTMEZ. Onaylanmış sürümler değiştirilmez; düzenleme yeni taslakla yapılır.
// İçerikteki yiyecek, porsiyon ve alerjen bilgileri uzmanındır; sistem tıbbi doğruluk iddia etmez.
// ═══════════════════════════════════════════════════════════════

enum PlanVersionStatus {
  DRAFT // Uzmanın çalışma kopyası (danışan görmez)
  APPROVED // Uzman onayladı; danışana yayında olan sürüm
  SUPERSEDED // Daha yeni bir sürüm yayınlandı
}

// Bir uzman–danışan çifti için tek plan; sürümler geçmişi oluşturur.
model NutritionPlan {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  createdAt      DateTime @default(now())

  professional User          @relation("planOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User          @relation("planSubject", fields: [clientId], references: [id], onDelete: Cascade)
  versions     PlanVersion[]
  events       PlanEvent[]
  choices      PlanChoice[]

  @@unique([professionalId, clientId])
}

// `number` onaylanınca verilir (taslakta boş). `content`: öğünler, alternatifler, porsiyonlar, değiştirme kuralları (JSON).
model PlanVersion {
  id            String            @id @default(uuid())
  planId        String
  number        Int?
  status        PlanVersionStatus @default(DRAFT)
  content       Json
  changeNote    String?
  basedOnNumber Int? // Hangi sürümden türetildi
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  // Onay anında uzmanın bilerek geçtiği uyarılar (kayıt için)
  acknowledged  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, number])
  @@index([planId, status])
}

// Plan geçmişi: kim, ne zaman, ne yaptı. Sadece eklenir.
model PlanEvent {
  id        String   @id @default(uuid())
  planId    String
  versionId String?
  kind      String // DRAFT_CREATED | DRAFT_EDITED | DRAFT_DISCARDED | APPROVED | SUPERSEDED
  text      String?
  byId      String?
  createdAt DateTime @default(now())

  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

// Danışanın bir gün için bir öğünde seçtiği alternatif(ler). Sadece o sürümde izinli seçenekler seçilebilir.
model PlanChoice {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  versionId String
  date      String // YYYY-AA-GG
  mealId    String
  optionIds String[]
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, date, mealId])
  @@index([planId, date])
}

// ═══════════════════════════════════════════════════════════════
// RANDEVU, HEDEF VE HATIRLATMA — profesyonel ajanda ve gelişim takibi
// ═══════════════════════════════════════════════════════════════

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW // Danışan gelmedi
}

enum AppointmentMode {
  ONLINE
  IN_PERSON
}

// `notes` ve `outcome` uzmana özeldir; danışan sadece zaman, şekil, başlık ve yeri görür.
model Appointment {
  id             String            @id @default(uuid())
  professionalId String
  clientId       String
  startsAt       DateTime
  durationMin    Int               @default(45)
  mode           AppointmentMode
  status         AppointmentStatus @default(SCHEDULED)
  title          String?
  location       String?
  notes          String? // Uzmanın hazırlık notu
  outcome        String? // Görüşme özeti (tamamlanınca)
  cancelledById  String?
  cancelReason   String?
  // Danışana "yarın randevun var" hatırlatması gönderildi mi
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  professional User @relation("appointmentOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User @relation("appointmentSubject", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DROPPED
}

// Uzmanın danışanla belirlediği hedef. Ölçüm hedefinde başlangıç değeri hedef açılırken son ölçümden alınır.
// Hedef değerler uzmanındır; sistem "uygun hedef" önermez.
model ClientGoal {
  id              String           @id @default(uuid())
  professionalId  String
  clientId        String
  title           String
  measurementKind MeasurementKind? // Boşsa ölçülebilir olmayan (alışkanlık) hedefi
  startValue      Float?
  targetValue     Float?
  startDate       DateTime         @default(now())
  targetDate      DateTime?
  status          GoalStatus       @default(ACTIVE)
  note            String?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())

  professional User @relation("goalOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User @relation("goalSubject", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([professionalId, clientId, status])
}

// Uzmanın danışana zamanlı hatırlatması; zamanı gelince danışana bildirim gider.
model ClientReminder {
  id             String    @id @default(uuid())
  professionalId String
  clientId       String
  text           String
  remindAt       DateTime
  sentAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  professional User @relation("reminderOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User @relation("reminderSubject", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@index([professionalId, clientId])
}

// ═══════════════════════════════════════════════════════════════
// EGZERSİZ PROGRAMI VE ANTRENMAN KAYITLARI — kişisel antrenör iş akışı
// Program, beslenme planıyla aynı kurallarla çalışır: uzman onaylamadan danışana gitmez, onaylanan sürüm değişmez.
// Egzersiz, set, tekrar ve yük bilgileri uzmanındır; sistem tıbbi/sportif doğruluk iddia etmez.
// ═══════════════════════════════════════════════════════════════

model TrainingProgram {
  id             String   @id @default(uuid())
  professionalId String
  clientId       String
  createdAt      DateTime @default(now())

  professional User                     @relation("programOwner", fields: [professionalId], references: [id], onDelete: Cascade)
  client       User                     @relation("programSubject", fields: [clientId], references: [id], onDelete: Cascade)
  versions     TrainingProgramVersion[]
  events       ProgramEvent[]
  logs         WorkoutLog[]

  @@unique([professionalId, clientId])
}

model TrainingProgramVersion {
  id            String            @id @default(uuid())
  programId     String
  number        Int?
  status        PlanVersionStatus @default(DRAFT)
  content       Json // Günler ve egzersizler (set, tekrar, yük, dinlenme, not)
  changeNote    String?
  basedOnNumber Int?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  acknowledged  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, number])
  @@index([programId, status])
}

model ProgramEvent {
  id        String   @id @default(uuid())
  programId String
  versionId String?
  kind      String // DRAFT_CREATED | DRAFT_DISCARDED | APPROVED | SUPERSEDED
  text      String?
  byId      String?
  createdAt DateTime @default(now())

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, createdAt])
}

// Antrenman kaydı: danışanın (ya da yüz yüze seansta uzmanın) girdiği gerçekleşen antrenman.
// `entries`: [{ exerciseId?, name, sets: [{ reps, loadKg? }] }]. Ağrı bildirimi uzmana kırmızı madde olarak düşer.
model WorkoutLog {
  id          String     @id @default(uuid())
  userId      String
  programId   String?
  versionId   String?
  dayId       String?
  date        String // YYYY-AA-GG
  entries     Json
  rpe         Int? // Algılanan efor 1–10
  pain        Boolean    @default(false)
  painNote    String?
  note        String?
  source      DataSource
  enteredById String?
  createdAt   DateTime   @default(now())

  user    User             @relation("workoutSubject", fields: [userId], references: [id], onDelete: Cascade)
  program TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([programId, date])
}

// ═══════════════════════════════════════════════════════════════
// SPOR SALONU — ekip, paketler, üyeler, üyelikler ve ödeme KAYITLARI
// Uygulama ödeme almaz: salon resepsiyonda aldığı ödemeyi buraya işler (nakit/kart/havale).
// Üyelerin kişisel verilerinin sorumlusu salondur (KVKK); yalnızca gerekli alanlar tutulur.
// Tutarlar kuruş cinsinden tamsayıdır.
// ═══════════════════════════════════════════════════════════════

model Gym {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  name      String
  address   String?
  city      String?
  phone     String?
  createdAt DateTime @default(now())

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff       GymStaffMember[]
  plans       MembershipPlan[]
  members     GymMember[]
  payments    GymPayment[]
  lessons     GymLesson[]
  bookings    GymBooking[]
  sessionLogs GymSessionLog[]
  tasks       GymTask[]
  shifts      GymShift[]
}

enum GymStaffRole {
  TRAINER // Salon eğitmeni
  RECEPTION // Resepsiyon / ön büro
}

enum GymStaffStatus {
  INVITED
  ACTIVE
  DECLINED
  ENDED
}

// Salonun ekibi: sahibi kullanıcı adıyla davet eder, kişi kabul edince ekibe katılır.
model GymStaffMember {
  id          String         @id @default(uuid())
  gymId       String
  userId      String
  role        GymStaffRole
  status      GymStaffStatus @default(INVITED)
  invitedById String
  invitedAt   DateTime       @default(now())
  joinedAt    DateTime?
  endedAt     DateTime?

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation("gymStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
  @@index([userId, status])
}

// Üyelik paketi (ör. "1 aylık", "10 ders özel"). Fiyatı salon belirler.
model MembershipPlan {
  id           String   @id @default(uuid())
  gymId        String
  name         String
  durationDays Int
  sessionCount Int? // Boşsa sınırsız giriş; doluysa ders/seans hakkı
  priceKurus   Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([gymId, active])
}

enum GymMemberStatus {
  ACTIVE
  ARCHIVED
}

// Salon üyesi: uygulama hesabı olması gerekmez.
model GymMember {
  id          String          @id @default(uuid())
  gymId       String
  fullName    String
  phone       String?
  note        String?
  status      GymMemberStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime        @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]
  payments    GymPayment[]
  bookings    GymBooking[]

  @@index([gymId, status])
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
}

// Üyenin satın aldığı üyelik. Paket bilgisi satış anındaki haliyle kopyalanır (sonradan paket değişse de bu kayıt değişmez).
model Membership {
  id            String           @id @default(uuid())
  gymId         String
  memberId      String
  planId        String?
  planName      String
  startDate     DateTime         @db.Date
  endDate       DateTime         @db.Date
  sessionsTotal Int?
  sessionsLeft  Int?
  priceKurus    Int
  status        MembershipStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime         @default(now())
  cancelledAt   DateTime?
  cancelReason  String?

  member   GymMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments GymPayment[]

  @@index([gymId, endDate])
  @@index([memberId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// Ödeme KAYDI (para uygulamadan geçmez). Silinmez; hatalı kayıt gerekçeyle iptal edilir.
model GymPayment {
  id           String        @id @default(uuid())
  gymId        String
  memberId     String
  membershipId String?
  amountKurus  Int
  method       PaymentMethod
  paidAt       DateTime
  recordedById String
  note         String?
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime      @default(now())

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     GymMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([gymId, paidAt])
  @@index([memberId])
}

enum GymLessonKind {
  GROUP
  PRIVATE
}

enum GymLessonStatus {
  SCHEDULED
  CANCELLED
}

// Salon dersi. Tarih ve saat salonun yerel saatidir (gün + "18:00"); saat dilimi dönüşümü yapılmaz.
// Haftalık tekrarlanan dersler aynı seriesId'yi taşır; her hafta ayrı bir derstir.
model GymLesson {
  id           String          @id @default(uuid())
  gymId        String
  kind         GymLessonKind
  title        String
  trainerId    String // Dersi veren kişinin kullanıcı kimliği (salon sahibi ya da ekipteki eğitmen)
  date         DateTime        @db.Date
  startTime    String // "HH:MM"
  durationMin  Int
  capacity     Int // Özel derste 1
  seriesId     String?
  status       GymLessonStatus @default(SCHEDULED)
  cancelReason String?
  cancelledAt  DateTime?
  createdById  String
  createdAt    DateTime        @default(now())

  gym      Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  bookings GymBooking[]

  @@index([gymId, date])
  @@index([trainerId, date])
}

enum GymBookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// Üyenin derse kaydı ve katılımı. "Katıldı" işaretlenince uygun üyelikten 1 ders hakkı düşer (deducted);
// işaret geri alınırsa hak geri eklenir. Her değişiklik GymSessionLog'a yazılır.
model GymBooking {
  id           String           @id @default(uuid())
  gymId        String
  lessonId     String
  memberId     String
  status       GymBookingStatus @default(BOOKED)
  membershipId String? // Katılımın düştüğü (ya da kapsadığı) üyelik
  deducted     Boolean          @default(false)
  markedById   String?
  markedAt     DateTime?
  createdById  String
  createdAt    DateTime         @default(now())

  gym    Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  lesson GymLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([lessonId, memberId])
  @@index([memberId])
}

// Ders hakkı hareketleri: kim, ne zaman, hangi ders için düştü ya da geri eklendi. Sadece eklenir.
model GymSessionLog {
  id           String   @id @default(uuid())
  gymId        String
  membershipId String
  bookingId    String?
  delta        Int // -1 düştü, +1 geri eklendi
  reason       String // ATTENDED, ATTENDANCE_UNDONE
  byId         String
  createdAt    DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([membershipId, createdAt])
}

// Ekip görevi: salon sahibi atar, görevli kişi tamamlar.
model GymTask {
  id          String    @id @default(uuid())
  gymId       String
  title       String
  assigneeId  String // Kullanıcı kimliği
  dueDate     DateTime? @db.Date
  doneAt      DateTime?
  doneById    String?
  createdById String
  createdAt   DateTime  @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, doneAt])
  @@index([assigneeId, doneAt])
}

// Haftalık vardiya şablonu: kişi başına haftanın her günü için bir satır (kayıt yoksa izinli).
model GymShift {
  id        String @id @default(uuid())
  gymId     String
  userId    String
  weekday   Int // 0 = Pazartesi … 6 = Pazar
  startTime String // "HH:MM"
  endTime   String

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId, weekday])
}

// Denetim kaydı: bir kişinin sağlık verisine kim, ne zaman, ne yaptı. Sadece eklenir; değiştirilmez.
// Kaydın konusu olan kullanıcı (targetUser) neyin kimle paylaşıldığını ve kimin baktığını buradan görür.
// targetUser silinince kayıtları da silinir; actor silinirse kayıt kalır, actorId boşalır.
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  targetUserId   String
  // OFFER_SENT, OFFER_ACCEPTED, OFFER_DECLINED, SHARING_CHANGED, RELATIONSHIP_ENDED, DATA_VIEWED, ACCESS_DENIED ...
  action         String
  category       String? // SharedDataType değeri
  relationshipId String?
  meta           Json?
  createdAt      DateTime @default(now())

  actor      User? @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User  @relation("auditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

// Sadece danışan bağlantısı kurulmuş (acceptedAt dolu) kullanıcılar yazabilir
model Review {
  id             String    @id @default(uuid())
  professionalId String
  authorId       String
  rating         Int // 1–5
  comment        String?
  reply          String? // Profesyonelin tek cevabı
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  author       User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([professionalId, authorId]) // Kişi başı bir yorum
}

// ═══════════════════════════════════════════════════════════════
// MESAJLAŞMA — docs/features/messaging.md
// ═══════════════════════════════════════════════════════════════

enum ConversationStatus {
  REQUESTED // Normal kullanıcıya giden ilk mesaj, kabul bekliyor
  OPEN
  DECLINED
}

model Conversation {
  id            String             @id @default(uuid())
  status        ConversationStatus @default(OPEN)
  initiatorId   String
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime? // Okundu bilgisi

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String?
  fileId         String? // Fotoğraf gönderildiyse
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // Silinen mesaj iz bırakır (şikayet incelemesi için)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// DİĞER
// ═══════════════════════════════════════════════════════════════

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // "new_message", "follow_request", "client_offer"...
  // Bildirim merkezi: PRO (uzman, randevu, plan, salon) ya da SOCIAL (takip, beğeni, yorum, bahsetme)
  center    String    @default("PRO")
  actorId   String? // Sosyal bildirimde eylemi yapan kişi
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, center, createdAt])
}

// Bildirim tercihleri (kayıt yoksa hepsi açık, sessiz saat yok). Anlık bildirim (push) sadece kişi izin verirse.
model NotificationPreference {
  userId      String  @id
  likes       Boolean @default(true)
  comments    Boolean @default(true)
  follows     Boolean @default(true)
  mentions    Boolean @default(true)
  stories     Boolean @default(true)
  messages    Boolean @default(true)
  pushEnabled Boolean @default(false)
  // Sessiz saatler (Türkiye saatiyle, 0-23). İkisi de doluysa bu aralıkta anlık bildirim gönderilmez.
  quietFrom   Int?
  quietTo     Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Anlık bildirim için cihaz kaydı (kişi izin verince eklenir, çıkışta silinir)
model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // ios, android, web
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Yüklenen dosyalar (fotoğraf, belge, video). Dosyanın kendisi depolama servisinde durur.
model File {
  id         String   @id @default(uuid())
  ownerId    String?
  storageKey String   @unique // Depolama servisindeki yolu
  mimeType   String
  sizeBytes  Int
  isPrivate  Boolean  @default(true)
  // Sosyal medya için: AVATAR, POST, STORY, MESSAGE, GROUP (boşsa eski belge/fotoğraf kayıtları)
  purpose    String?
  createdAt  DateTime @default(now())

  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  progressPhotos        ProgressPhoto[]
  professionalDocuments ProfessionalDocument[]
  postMedia             PostMedia[]
  stories               Story[]
  dmMessages            DmMessage[]
  dmGroups              DmConversation[]
}

// ═══════════════════════════════════════════════════════════════
// KAYIT VE PROFESYONEL BAŞVURU — docs/features/registration.md
// ═══════════════════════════════════════════════════════════════

enum AccountType {
  USER
  PROFESSIONAL
}

// Profesyonel olarak açılmak istenen alan (hesap açılırken seçilir)
enum ProfessionalField {
  DIETITIAN
  TRAINER
  GYM_OWNER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// E-posta doğrulama kodu girilene kadar hesap OLUŞMAZ; kayıt bilgileri burada geçici tutulur.
// Kullanıcı adı ve e-posta bu sürede (kısa süre) rezerve sayılır.
model PendingRegistration {
  id            String      @id @default(uuid())
  email         String
  username      String
  passwordHash  String
  accountType   AccountType
  // Ad, doğum tarihi, rızalar, profesyonel alan ve alana özel bilgiler
  payload       Json
  codeHash      String // Doğrulama kodunun özeti (kodun kendisi saklanmaz)
  codeExpiresAt DateTime
  attempts      Int         @default(0)
  sendCount     Int         @default(1)
  lastSentAt    DateTime    @default(now())
  expiresAt     DateTime
  ipAddress     String?
  createdAt     DateTime    @default(now())

  documents PendingDocument[]

  @@index([email])
  @@index([username])
  @@index([expiresAt])
}

model PendingDocument {
  id             String   @id @default(uuid())
  registrationId String
  kind           String // "diploma", "certificate", "business_license"...
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String   @unique
  // Otomatik işaretler: DUPLICATE_DOCUMENT, EDITING_SOFTWARE_TRACE...
  flags          String[]
  createdAt      DateTime @default(now())

  registration PendingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// Profesyonel hesap başvurusu. Onaylanana kadar kişi sadece standart kullanıcıdır.
model ProfessionalApplication {
  id              String            @id @default(uuid())
  userId          String
  field           ProfessionalField
  status          ApplicationStatus @default(PENDING)
  // Şehir, uzmanlık alanları, salon adı/adresi gibi alana özel bilgiler
  details         Json
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  attemptNumber   Int               @default(1)
  submittedAt     DateTime          @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ApplicationDocument[]

  @@index([status, submittedAt])
  @@index([userId])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  kind          String
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String
  storageKey    String   @unique
  flags         String[]
  createdAt     DateTime @default(now())

  application ProfessionalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  accessLogs  DocumentAccessLog[]

  @@index([sha256])
}

// Belgeleri kim, ne zaman açtı (kişisel veri olduğu için kayıt altındadır)
model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String
  adminId    String
  at         DateTime @default(now())

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ═══════════════════════════════════════════════════════════════
// İÇERİK KÜTÜPHANESİ — katılınan ücretsiz programlar ve görevler (içeriğin kendisi kodda: modules/library/catalog.ts)
// ═══════════════════════════════════════════════════════════════

enum LibraryEnrollmentStatus {
  ACTIVE
  COMPLETED
  LEFT
}

// "Programa katıl": program günleri başlangıç tarihinden itibaren haftaya yayılır ve Programım'da gün gün görünür
model LibraryEnrollment {
  id        String                  @id @default(uuid())
  userId    String
  programId String // catalog.ts PROGRAMS[].id
  startDate DateTime                @db.Date
  status    LibraryEnrollmentStatus @default(ACTIVE)
  createdAt DateTime                @default(now())
  endedAt   DateTime?

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions LibraryCompletion[]

  @@index([userId, status])
}

// Program gününde yapılan hareket (tamamlandı işareti)
model LibraryCompletion {
  id           String   @id @default(uuid())
  enrollmentId String
  dayIndex     Int
  stepIndex    Int
  doneAt       DateTime @default(now())

  enrollment LibraryEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, dayIndex, stepIndex])
}

// Tek bir hareketi belirli bir günün görevlerine ekleme ("Görevime ekle")
model LibraryTask {
  id        String    @id @default(uuid())
  userId    String
  itemId    String // catalog.ts ITEMS[].id
  date      DateTime  @db.Date
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, date])
  @@index([userId, date])
}

// ═══════════════════════════════════════════════════════════════
// GÖNDERİLER — metin, en fazla 5 fotoğraf (video 6. aşamada), beğeni, yorum, kaydetme, alıntı, etiket
// Görünürlük hesabın gizliliğine bağlıdır: açık hesap herkese, gizli hesap kabul edilmiş takipçilere.
// ═══════════════════════════════════════════════════════════════

model Post {
  id           String    @id @default(uuid())
  authorId     String
  text         String?
  quotedPostId String? // Alıntılanan gönderi (silinirse alıntı "görüntülenemiyor" olur)
  pinnedAt     DateTime? // Profilde en üstte (en fazla 3)
  editedAt     DateTime?
  deletedAt    DateTime? // Kişi sildi
  removedAt    DateTime? // Moderasyon kaldırdı
  createdAt    DateTime  @default(now())

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  quoted   Post?         @relation("quote", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes   Post[]        @relation("quote")
  media    PostMedia[]
  likes    PostLike[]
  saves    PostSave[]
  comments PostComment[]
  hashtags PostHashtag[]
  mentions PostMention[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

enum PostMediaKind {
  IMAGE
  VIDEO
}

model PostMedia {
  id         String        @id @default(uuid())
  postId     String
  fileId     String
  kind       PostMediaKind @default(IMAGE)
  sortOrder  Int           @default(0)
  // Video süresi (ms); fotoğrafta boş
  durationMs Int?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId])
  @@index([postId, sortOrder])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostSave {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

// Yorum ve yanıt (tek seviye: yanıtın yanıtı aynı yorumun altına eklenir)
model PostComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  text      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  removedAt DateTime?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("replies")

  @@index([postId, parentId, createdAt])
}

model PostHashtag {
  postId String
  tag    String // küçük harf, # olmadan

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag])
}

model PostMention {
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// ═══════════════════════════════════════════════════════════════
// HİKÂYELER — 24 saat görünür, sonra sadece sahibinin arşivinde kalır
// Kitle: herkes (hesap gizliyse kabul edilmiş takipçiler), sadece takipçiler ya da yakın arkadaşlar.
// Çıkartmalar: anket, soru, emoji tepkisi, bahsetme, bağlantı, elle yazılan konum, başarı paylaşımı.
// ═══════════════════════════════════════════════════════════════

enum StoryAudience {
  EVERYONE
  FOLLOWERS
  CLOSE_FRIENDS
}

model Story {
  id           String         @id @default(uuid())
  authorId     String
  fileId       String? // Fotoğraf ya da video (metin hikâyesinde boş)
  mediaKind    PostMediaKind?
  durationMs   Int?
  text         String? // Metin hikâyesi ya da fotoğraf üstü yazı
  background   String? // Metin hikâyesinin arka plan rengi (uygulamanın sabit listesinden)
  audience     StoryAudience  @default(EVERYONE)
  poll         Json? // { question, options: [a, b] }
  question     String? // Soru çıkartması (izleyenler yanıtlar, sadece sahibi görür)
  mentions     String[]       @default([]) // Bahsedilen kişilerin kimlikleri
  linkUrl      String?
  linkLabel    String?
  locationText String? // Elle yazılan konum (cihaz konumu kullanılmaz)
  achievement  Json? // { kind, title } — sunucuda doğrulanan başarı (sağlık ölçümü içermez)
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  deletedAt    DateTime?
  removedAt    DateTime?

  author  User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  file    File?           @relation(fields: [fileId], references: [id], onDelete: SetNull)
  views   StoryView[]
  votes   StoryPollVote[]
  answers StoryAnswer[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  reaction String? // Emoji tepkisi

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
}

model StoryPollVote {
  storyId String
  userId  String
  option  Int
  votedAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
}

model StoryAnswer {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
}

// Yakın arkadaşlar listesi (hikâye kitlesi için; listedekiler listede olduklarını görmez)
model CloseFriend {
  ownerId   String
  friendId  String
  createdAt DateTime @default(now())

  owner  User @relation("closeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("closeFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([ownerId, friendId])
}

// ═══════════════════════════════════════════════════════════════
// SOSYAL MESAJLAR (DM) VE GRUPLAR — uzman–danışan yazışmasından tamamen ayrıdır
// Takip etmediğin birinden gelen ilk mesaj "İstekler"e düşer; kabul edilene kadar fotoğraf/video gönderilemez.
// ═══════════════════════════════════════════════════════════════

enum DmPolicy {
  EVERYONE
  FOLLOWING
}

enum DmConversationKind {
  DIRECT
  GROUP
}

model DmConversation {
  id            String             @id @default(uuid())
  kind          DmConversationKind
  directKey     String?            @unique // İki kişilik sohbette sıralı kullanıcı kimlikleri (tek sohbet)
  title         String?
  avatarFileId  String?
  createdById   String
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())

  avatar   File?       @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  members  DmMember[]
  messages DmMessage[]

  @@index([lastMessageAt])
}

enum DmMemberRole {
  MEMBER
  ADMIN
}

enum DmMemberStatus {
  ACTIVE
  REQUEST // Mesaj isteği: alıcı henüz kabul etmedi
  LEFT
  REMOVED
}

model DmMember {
  conversationId  String
  userId          String
  role            DmMemberRole   @default(MEMBER)
  status          DmMemberStatus @default(ACTIVE)
  joinedAt        DateTime       @default(now())
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  clearedAt       DateTime? // "Sohbeti sil": bu tarihten önceki mesajlar bu kişide görünmez
  mutedUntil      DateTime?

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, status])
}

enum DmMessageKind {
  TEXT
  IMAGE
  VIDEO
  VOICE
  POST // Paylaşılan gönderi
  STORY_REPLY // Hikâyeye yanıt
  SYSTEM // Gruba eklendi, ayrıldı, ad değişti...
}

model DmMessage {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  kind           DmMessageKind
  text           String?
  fileId         String?
  durationMs     Int?
  replyToId      String?
  postId         String?
  storyId        String?
  createdAt      DateTime      @default(now())
  unsentAt       DateTime? // Gönderen geri aldı (herkesten silinir)

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  file         File?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  replyTo      DmMessage?     @relation("dmReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DmMessage[]    @relation("dmReply")
  hiddenFor    DmHidden[]

  @@index([conversationId, createdAt])
}

// "Benden sil": mesaj sadece bu kişide gizlenir
model DmHidden {
  messageId String
  userId    String

  message DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

// ═══════════════════════════════════════════════════════════════
// KİŞİSEL 28 GÜNLÜK PROGRAM — docs/features/personal-plan.md
// Tek seferlik satın alma, sabit 28 takvim günü, otomatik yenileme yok. Erişim sunucuda doğrulanan satın almaya bağlıdır.
// ═══════════════════════════════════════════════════════════════

enum PlanPurchaseStatus {
  PAID
  FAILED
  REFUNDED
}

enum PlanLogStatus {
  DONE
  SKIPPED
}

// Giriş formu ve güvenlik taraması (her dönem için ayrı kayıt; eskisi silinmez ya da değiştirilmez)
model PlanIntake {
  id        String   @id @default(uuid())
  userId    String
  data      Json
  screening Json
  eligible  Boolean
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases PlanPurchase[]
  instances PlanInstance[]

  @@index([userId, createdAt])
}

model PlanPurchase {
  id             String             @id @default(uuid())
  userId         String
  intakeId       String
  // Aynı isteğin tekrarında çift kayıt ve çift ücret oluşmasın diye
  idempotencyKey String
  status         PlanPurchaseStatus @default(PAID)
  provider       String // DEV (geliştirme); gerçek ödeme sağlayıcısı sonra
  amountMinor    Int? // Boşsa fiyat yer tutucudur
  currency       String             @default("TRY")
  purchaseDay    DateTime           @db.Date // Türkiye günü; başlangıç tarihi bu günden itibaren en fazla 14 gün sonrası
  paidAt         DateTime           @default(now())
  createdAt      DateTime           @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  intake   PlanIntake    @relation(fields: [intakeId], references: [id])
  instance PlanInstance?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model PlanInstance {
  id                 String    @id @default(uuid())
  userId             String
  purchaseId         String    @unique
  intakeId           String
  sequence           Int // Kullanıcının kaçıncı dönemi
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date // başlangıç + 27 gün
  // Hangi kurallarla üretildiği (eski programlar anlaşılabilsin)
  engineVersion      String
  // Motor parametreleri ve açıklama kaydı (seviye, kısıtlar, haftalık karar gerekçeleri)
  params             Json
  previousInstanceId String?
  generatedWeeks     Int       @default(1)
  needsProfessional  Boolean   @default(false)
  report             Json?
  reportedAt         DateTime?
  createdAt          DateTime  @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase PlanPurchase   @relation(fields: [purchaseId], references: [id])
  intake   PlanIntake     @relation(fields: [intakeId], references: [id])
  days     PlanDay[]
  logs     PlanEntryLog[]

  @@unique([userId, sequence])
  @@index([userId, startDate])
}

model PlanDay {
  id               String   @id @default(uuid())
  instanceId       String
  dayNumber        Int // 1-28
  weekNumber       Int
  date             DateTime @db.Date
  kind             String // TRAINING | REST
  focus            String?
  title            String
  estimatedMinutes Int
  estimatedKcal    Int
  entries          Json

  instance PlanInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, dayNumber])
  @@index([instanceId, date])
}

model PlanEntryLog {
  id            String        @id @default(uuid())
  instanceId    String
  dayNumber     Int
  entryIndex    Int
  status        PlanLogStatus
  rpe           Int? // Algılanan zorlanma 1-10
  pain          Boolean       @default(false)
  painArea      String?
  painSharp     Boolean       @default(false)
  note          String?
  actualReps    Int?
  actualSeconds Int?
  loggedAt      DateTime      @default(now())

  instance PlanInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, dayNumber, entryIndex])
}
